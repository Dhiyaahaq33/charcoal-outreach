# Kirim WhatsApp via Fonnte (fonnte.com). Device = nomor +62 812-2564-6585, di-pairing SEKALI lewat
# scan QR di dashboard Fonnte - setelah itu pengiriman ditangani server Fonnte, HP/PC kamu gak
# perlu nyala terus. FONNTE_TOKEN: dashboard > pilih device > Token.
# Kosong/error = kirim WhatsApp di-skip diam-diam per baris (fallback ke email), run tetap lanjut.
FONNTE_TOKEN=

# Kirim email via Gmail SMTP + App Password (bukan password akun biasa - butuh 2FA aktif dulu).
# Bikin di: myaccount.google.com/apppasswords
# Kosong = kirim email di-skip diam-diam per baris, run tetap lanjut (WA-only kalau ada nomornya).
GMAIL_ADDRESS=johanneshaq@gmail.com
GMAIL_APP_PASSWORD=

# Baca & tulis balik Google Sheet "Export Charcoal Business" tab CLIENT.
# GOOGLE_SHEET_ID: dari URL sheet, https://docs.google.com/spreadsheets/d/<ID INI>/edit
# GOOGLE_SERVICE_ACCOUNT_JSON: isi UTUH file JSON key service account (satu baris).
# Cara bikin: console.cloud.google.com > project > IAM & Admin > Service Accounts > Create >
# Keys > Add Key > JSON. Share sheet-nya (tombol Share) ke email service account itu
# (client_email di JSON-nya), role Editor - tanpa ini baca/tulis bakal gagal.
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Nama tab yang berisi data client (default: CLIENT, sesuai sheet aslinya).
CLIENT_SHEET_TAB=CLIENT

# true = hitung siapa yang mau di-offer & render pesannya, TAPI gak benar-benar kirim & gak nulis
# balik ke sheet - cuma di-log. Pakai ini dulu buat testing sebelum live.
DRY_RUN=true
